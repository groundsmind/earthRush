[sub_resource type="GDScript" id="GDScript_yf5fn"]
resource_name = "BunySpawn"
script/source = "extends Node2D

const BUNY = preload(\"uid://bklj8nud0y3q6\")

@onready var timer: Timer = $Timer

func _ready() -> void:
	reproduce()

func _on_timer_timeout() -> void:
	timer.wait_time = randf_range(4, 8)
	reproduce()

func reproduce() -> void:
	var bunny = BUNY.instantiate()
	add_child(bunny)
"

