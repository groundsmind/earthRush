[sub_resource type="GDScript" id="GDScript_57qmd"]
script/source = "extends Area2D

@onready var col: CollisionShape2D = $col
@onready var trash_sprites: Array[Sprite2D] = [
	$col/Paper,
	$col/Glass,
	$col/Metal,
	$col/Plastic
]

var right_trash: Sprite2D

func _ready() -> void:
	right_trash = trash_sprites.pick_random()
	right_trash.show()

func _physics_process(_delta: float) -> void:
	col.position.y += 2
"

