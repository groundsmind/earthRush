[sub_resource type="GDScript" id="GDScript_ccisx"]
resource_name = "FlowerScript"
script/source = "extends Area2D

@onready var timer: Timer = $Timer
@onready var flowersprite: AnimatedSprite2D = $flowersprite

var flower_state: int = 0
signal finished
var is_finished: bool = false

func _on_timer_timeout() -> void:
	if is_finished:
		return
		
	flowersprite.frame += 1 if flowersprite.frame < 2 else 0
	flower_state += 1
	
	if flower_state >= 2:
		is_finished = true
		timer.stop()
		set_collision_layer_value(3, false)
		finished.emit()
"

