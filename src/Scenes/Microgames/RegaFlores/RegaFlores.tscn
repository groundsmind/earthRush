[sub_resource type="GDScript" id="GDScript_gtpgk"]
script/source = "extends Sprite2D

@onready var ray_cast_2d: RayCast2D = $RayCast2D
@onready var droplets: GPUParticles2D = $droplets
@onready var timer: Timer = $Timer

var water_cycles: int = 0
signal flower_state_change
signal finished_watering

func _ready() -> void:
	timer.timeout.connect(_change_flower_state)

func _process(_delta: float) -> void:
	ray_cast_2d.rotation = -rotation
	
	var mouse_pos_y: float = get_viewport().get_mouse_position().y
	var distance: float = -(position.y - mouse_pos_y)
	distance = clampf(distance, 100, 520)
	var angle = remap(distance, 100, 520, 0, 40)
	rotation = deg_to_rad(angle)
	if angle > 35:
		droplets.emitting = true
		if ray_cast_2d.is_colliding():
			if timer.paused:
				timer.paused = false
			if timer.is_stopped():
				timer.start()
	else:
		timer.paused = true
		droplets.emitting = false

func _change_flower_state() -> void:
	flower_state_change.emit()
	if ray_cast_2d.get_collider():
		ray_cast_2d.get_collider().call(\"flower_state_change\")
	water_cycles += 1
	if water_cycles == 2:
		finished_watering.emit()
		water_cycles = 0
"

