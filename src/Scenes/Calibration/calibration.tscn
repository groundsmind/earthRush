[sub_resource type="GDScript" id="GDScript_ffumr"]
resource_name = "Calibration"
script/source = "extends Node2D

@onready var sprite: Sprite2D = $Sprite2D
@onready var scene_transition_rect: ColorRect = $SceneTransitionRect

var sprites: Dictionary = {
	\"avisos\": preload(\"res://TTEA/assets/avisos.png\"),
	\"calibrar\": preload(\"res://TTEA/assets/calibrar.png\"),
	\"calibracao_ok\": preload(\"res://TTEA/assets/calibracao_ok.png\"),
}

var state: String = \"avisos\"

func _ready() -> void:
	sprite.texture = sprites[state]
	Server.data_received.connect(_on_server_data_received)

func _process(_delta: float) -> void:
	match state:
		\"avisos\":
			if Input.is_key_pressed(KEY_C):
				Server.send_data(\"CAL\")
				switch_state(\"calibrar\")
			elif Input.is_key_pressed(KEY_Q):
				print(\"calibração cancelada\")
				scene_transition_rect.transition_to(\"res://Scenes/Title/TitleScreen.tscn\")
		\"calibracao_ok\":
			if Input.is_key_pressed(KEY_Q):
				print(\"calibração terminada\")
				Server.send_data(\"CAL_ACK\")
				scene_transition_rect.transition_to(\"res://Scenes/Title/TitleScreen.tscn\")

func switch_state(new_state: String) -> void:
	state = new_state
	sprite.texture = sprites[new_state]

func _on_server_data_received(data) -> void:
	if data is String and data == \"CAL_OK\":
		print(\"calibration over !! :)\")
		switch_state(\"calibracao_ok\")
"

