[sub_resource type="GDScript" id="GDScript_irlun"]
script/source = "extends Node2D

@onready var scene_transition_rect: SceneTransitionRect = $SceneTransitionRect
const SND_EXT = preload(\"uid://c7m4bpckw6cgk\")
const ELEVATORSTUCK = preload(\"uid://yn1efphcov3e\")

func _ready() -> void:
	SoundManager.play_music(ELEVATORSTUCK)

func _on_back_pressed() -> void:
	scene_transition_rect.transition_to(\"res://Scenes/Title/TitleScreen.tscn\")
	SoundManager.play_sound(SND_EXT)
	SoundManager.stop_music(1)
"

