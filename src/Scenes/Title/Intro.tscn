[sub_resource type="GDScript" id="GDScript_tm67p"]
resource_name = "sickassintro"
script/source = "extends Node2D

@onready var animation_player: AnimationPlayer = $AnimationPlayer
const TITLE_SCREEN = preload(\"uid://cal3gy6gs6ymk\")

func _ready() -> void:
	if false:#SaveManager.game_data.get(\"passed_first_boot\", false):
		get_tree().change_scene_to_packed(TITLE_SCREEN)
	else:
		animation_player.play(\"sick_ass_intro\")

func _on_animation_player_animation_finished(_anim_name: StringName) -> void:
	get_tree().change_scene_to_packed(TITLE_SCREEN)
"

