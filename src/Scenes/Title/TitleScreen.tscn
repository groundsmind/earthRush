[sub_resource type="GDScript" id="GDScript_g4v7s"]
resource_name = "ButtonMgr"
script/source = "extends Node2D

@onready var scene_transition_rect: ColorRect = $\"../SceneTransitionRect\"
const SND_CONFIRM = preload(\"uid://c7im588he86p1\")
const SND_EXT = preload(\"uid://c7m4bpckw6cgk\")
const SND_CAL = preload(\"uid://dibowit1if7u5\")

func _on_exit_pressed() -> void:
	scene_transition_rect.transition_to(\"res://Scenes/Title/Exit.tscn\")
	SoundManager.play_sound(SND_EXT)

func _on_start_pressed() -> void:
	scene_transition_rect.transition_to(\"res://Scenes/Game/MainGame.tscn\")
	SoundManager.play_sound(SND_CONFIRM)

func _on_cal_pressed() -> void:
	scene_transition_rect.transition_to(\"res://Scenes/Calibration/calibration.tscn\")
	SoundManager.play_sound(SND_CAL)

func _on_debug_pressed() -> void:
	scene_transition_rect.transition_to(\"res://foot_tracking/FootTrackingDebug/DebugScene.tscn\")
	SoundManager.play_sound(SND_CAL)

func _on_credits_pressed() -> void:
	scene_transition_rect.transition_to(\"res://Scenes/Title/Credits.tscn\")
	SoundManager.play_sound(SND_CONFIRM)
"

