[sub_resource type="GDScript" id="GDScript_5t1aa"]
resource_name = "ScoreSetter"
script/source = "extends HBoxContainer

@onready var score_value: Label = $score_value

func _ready() -> void:
	score_value.text = str(GameInfo.current_game.get(\"score\"))
"

[sub_resource type="GDScript" id="GDScript_wn6li"]
resource_name = "StatsDisplay"
script/source = "extends VBoxContainer

@onready var games_played_val: Label = $games_played_val

func _ready() -> void:
	games_played_val.text = str(GameInfo.current_game.get(\"games played\"))
"

[sub_resource type="GDScript" id="GDScript_4p3hf"]
resource_name = "ButtonMgr"
script/source = "extends Node2D

@onready var scene_transition_rect: ColorRect = $\"../SceneTransitionRect\"

func _on_replay_pressed() -> void:
	scene_transition_rect.transition_to(\"res://Scenes/Game/MainGame.tscn\")

func _on_recal_pressed() -> void:
	scene_transition_rect.transition_to(\"res://Scenes/Calibration/calibration.tscn\")

func _on_back_2_menu_pressed() -> void:
	scene_transition_rect.transition_to(\"res://Scenes/Title/TitleScreen.tscn\")
"

