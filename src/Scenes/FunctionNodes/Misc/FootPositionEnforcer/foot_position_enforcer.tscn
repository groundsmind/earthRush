[sub_resource type="GDScript" id="GDScript_ednfq"]
resource_name = "Spinny"
script/source = "extends Area2D

var colliding: bool = false
var des_progbar_value: float = 0.0
@onready var timer: Timer = $\"../Timer\"
@onready var progbar: TextureProgressBar = $TextureProgressBar

func _process(delta: float) -> void:
	if colliding:
		var time_elapsed = timer.wait_time - timer.time_left
		des_progbar_value = time_elapsed
	progbar.value = lerp(progbar.value, des_progbar_value, delta*5.0)

func _on_area_entered(_area: Area2D) -> void:
	var _modulate = create_tween().tween_property(self, \"modulate\", Color.GREEN, 0.25)
	progbar.max_value = timer.wait_time
	colliding = true

func _on_area_exited(_area: Area2D) -> void:
	var _modulate = create_tween().tween_property(self, \"modulate\", Color.WHITE, 0.25)
	des_progbar_value = 0.0
	colliding = false
"

[sub_resource type="CircleShape2D" id="CircleShape2D_x4otc"]
radius = 131.74597

[sub_resource type="GDScript" id="GDScript_g4v7s"]
script/source = "extends Area2D

@export var vertical_offset: float = 50.0

func _process(_delta: float) -> void:
	if FootPosition and FootPosition.midpoint != null:
		global_position = FootPosition.midpoint
		global_position.y += vertical_offset
"

