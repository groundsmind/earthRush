[sub_resource type="GDScript" id="GDScript_yf5fn"]
resource_name = "FootPositionEnfPositioner"
script/source = "extends Node2D

@onready var game_mgr: Node2D = $\"../../../..\"
@onready var fpe: FootPositionEnforcer = $\"..\"

func _ready() -> void:
	game_mgr.game_change.connect(_on_game_change)

func _on_game_change(game: PackedScene) -> void:
	print(\"hello enforcing the enforcer\")
	var game_scene: Node = game.instantiate()
	var enforcer_pos: Vector2 = game_scene.player_start.global_position
	var _fpe_pos_tween = create_tween().tween_property(fpe, \"global_position\", enforcer_pos, 0.25).set_ease(Tween.EASE_IN_OUT).set_trans(Tween.TRANS_QUAD)
	game_scene.queue_free()
"

