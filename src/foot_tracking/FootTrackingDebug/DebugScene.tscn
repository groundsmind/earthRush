[sub_resource type="GDScript" id="GDScript_lti8b"]
resource_name = "wawa"
script/source = "extends Node2D

@onready var label: Label = $Label
@onready var scene_transition_rect: ColorRect = $SceneTransitionRect
@onready var calibrate: Button = $MenuButtons/calibrate

func _process(_delta: float) -> void:
	if Server.data is Dictionary:
		label.text = str(Server.data['pos']) + \"\\n @\" + str(Server.delay_ms) + \"ms\"

func _on_calibrate_pressed() -> void:
	calibrate.disabled = true
	scene_transition_rect.transition_to(\"res://Scenes/Calibration/calibration.tscn\")

func _on_exit_pressed() -> void:
	Server.send_data(\"EXT\")
	Server.stop()
"

